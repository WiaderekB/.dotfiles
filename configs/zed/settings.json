{
  "auto_install_extensions": {
    "html": true,
    "java": true,
    "jetbrains-new-ui-icons": true,
    "one-dark-pro": true
  },
  "autosave": "on_focus_change",
  "base_keymap": "VSCode",
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_font_size": 12.5,
  "buffer_font_weight": 400,
  "buffer_line_height": {
    "custom": 1.4
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "cursor_animation": {
    "enabled": false
  },
  "cursor_shape": "bar",
  "edit_predictions": {
    "provider": "copilot"
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "minimap": {
    "max_width_columns": 85,
    "show": "always",
    "thumb": "hover"
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "ui_font_size": 15
}
